[Unit]
Description=ODSOFT LMS - produção
After=network.target

[Service]
Type=simple
User=odsoft
Group=odsoft
WorkingDirectory=/opt/odsoft
Environment="SPRING_PROFILES_ACTIVE=prod"
Environment="DATA_DIR=/opt/odsoft/data/prod"
Environment="SERVER_PORT=2228"
ExecStart=/usr/bin/java -Xms64m -Xmx128m -jar /opt/odsoft/current-prod/app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
