[Unit]
Description=ODSOFT LMS - staging
After=network.target

[Service]
Type=simple
User=odsoft
Group=odsoft
WorkingDirectory=/opt/odsoft
Environment="SPRING_PROFILES_ACTIVE=bootstrap,staging"
Environment="DATA_DIR=/opt/odsoft/data/staging"
Environment="SERVER_PORT=2225"
ExecStart=/usr/bin/java -Xms64m -Xmx128m -jar /opt/odsoft/current-staging/app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
