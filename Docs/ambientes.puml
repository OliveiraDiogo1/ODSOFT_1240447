@startuml
node "Máquina local" {
  node "Docker" {
    rectangle "dev :8091" as LocalDev
    rectangle "staging :8092" as LocalStaging
    rectangle "prod :8093" as LocalProd
  }
}

node "VM DEI vs264\nLXC 1,9 GB" as VM {
  rectangle "Jenkins :2226" as Jenkins
  rectangle "odsoft-dev :2224" as Dev
  rectangle "odsoft-staging :2225" as Staging
  rectangle "odsoft-prod :2228" as Prod
}

cloud "vs-gate" as Gate

LocalDev --> Gate
LocalStaging --> Gate
LocalProd --> Gate
Dev --> Gate : http
Staging --> Gate : http
Prod --> Gate : https
Jenkins --> Gate : https

note bottom of VM
  JAR + systemd, não Docker,
  por causa da memória e do LXC.
end note

@enduml
